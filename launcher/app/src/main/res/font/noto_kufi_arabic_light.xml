<?xml version="1.0" encoding="utf-8"?>
<!-- Noto Kufi Arabic (SIL OFL 1.1, launcher/FONT-LICENSE-OFL.txt) at weight 300, for the Arabic UI (Zaytoon fork).
     Subset to Basic Latin, Arabic and general punctuation; HarfBuzz joins the letters from the base block. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/noto_kufi_arabic"
        android:fontStyle="normal"
        android:fontWeight="300"
        android:fontVariationSettings="'wght' 300"
        tools:targetApi="28" />
</font-family>
