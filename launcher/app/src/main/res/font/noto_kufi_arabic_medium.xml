<?xml version="1.0" encoding="utf-8"?>
<!-- Noto Kufi Arabic (SIL OFL 1.1, launcher/FONT-LICENSE-OFL.txt) at weight 500, for the Arabic UI (Zaytoon fork).
     Subset to Basic Latin, the Arabic letters, harakat and digits, and common punctuation; HarfBuzz joins the letters from the base block. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/noto_kufi_arabic"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        tools:targetApi="28" />
</font-family>
